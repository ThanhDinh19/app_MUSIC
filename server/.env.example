# Sao chép file này thành `.env` để thay đổi cấu hình (không bắt buộc khi chạy thử).

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Nguồn dữ liệu: json (hiện tại) | mssql (giai đoạn 3 — xem src/data/mssql/README.md)
DATA_PROVIDER=json

# Thư mục (tương đối so với thư mục server/)
DATA_DIR=storage/data
SEED_DIR=storage/seed
MEDIA_DIR=storage/media
# Token của dịch vụ ngoài (Zalo OA) — KHÔNG commit thư mục này
SECRETS_DIR=storage/secrets

# Đường dẫn public của file media. Sau này có thể đổi sang CDN, ví dụ https://cdn.example.com/media
MEDIA_BASE_URL=/media

# Thư mục build của client (server sẽ phục vụ luôn giao diện ở production)
CLIENT_DIST_DIR=../client/dist

# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy). Để trống nếu dùng chung domain.
CORS_ORIGINS=

# Dành cho giai đoạn chuyển sang SQL Server
MSSQL_CONNECTION_STRING=

# ───────────────────────────── Đăng nhập ─────────────────────────────

# Khoá bí mật để băm mã OTP. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Thời gian giữ đăng nhập (ngày)
SESSION_TTL_DAYS=60

# Google: tạo "OAuth client ID" loại Web application tại https://console.cloud.google.com/apis/credentials
#  - Authorized JavaScript origins: http://localhost:5173, http://localhost:4000, https://<tên-miền-của-bạn>
#  - Authorized redirect URIs (cho PWA đã cài): https://<tên-miền-của-bạn>/api/auth/google/redirect
GOOGLE_CLIENT_ID=

# Mã OTP đăng nhập bằng số điện thoại Zalo:
#  console = chế độ thử nghiệm (mã in ra terminal và hiện trên màn hình, KHÔNG gửi tin thật)
#  zalo    = gửi thật qua Zalo Notification Service (ZNS) — cần đủ các biến ZALO_* bên dưới
OTP_PROVIDER=console

# Zalo for Developers (https://developers.zalo.me) → ứng dụng đã liên kết với Zalo Official Account
ZALO_APP_ID=
ZALO_APP_SECRET=
# Refresh token lấy được sau khi OA cấp quyền cho ứng dụng. Server sẽ tự làm mới và lưu token mới vào SECRETS_DIR.
ZALO_OA_REFRESH_TOKEN=
# ID mẫu tin ZNS loại "OTP" đã được Zalo duyệt, và tên tham số chứa mã trong mẫu đó
ZALO_ZNS_TEMPLATE_ID=
ZALO_ZNS_OTP_PARAM=otp
# development = chỉ gửi được tới số điện thoại quản trị viên của OA (để thử, không tính phí)
ZALO_ZNS_MODE=production
